{
  "name": "@open-sauce/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Source-preserving Open Sauce Food parser and human recipe renderers",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vocabulary/node": {
      "types": "./dist/vocabulary/node.d.ts",
      "import": "./dist/vocabulary/node.js"
    }
  },
  "files": [
    "dist",
    "knowledge/**/*.yaml",
    "LICENSE",
    "LICENSING.md",
    "LICENSES",
    "assets/brand/*.svg"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test tests/*.test.ts",
    "corpus": "node tools/corpus.ts",
    "quality:audit": "node tools/quality-audit.ts",
    "docs:check": "node tools/check-docs.ts",
    "source:check": "node tools/check-public-source.ts",
    "prepack": "tsc -p tsconfig.build.json",
    "package:smoke": "node tools/package-smoke.ts"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.25.0",
  "license": "SEE LICENSE IN LICENSE",
  "bin": {
    "opensauce": "./dist/cli.js"
  }
}
